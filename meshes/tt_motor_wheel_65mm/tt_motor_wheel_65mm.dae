     <bind_material><technique_common>
       <instance_material symbol="rim" target="#rim-material"/>
     </technique_common></bind_material>
    </instance_geometry>
   </node>
   <node id="tt_motor_wheel_65mm-tyre-node" name="tyre">
    <instance_geometry url="#tt_motor_wheel_65mm-tyre">
     <bind_material><technique_common>
       <instance_material symbol="tyre" target="#tyre-material"/>
     </technique_common></bind_material>
    </instance_geometry>
   </node>
  </visual_scene>
 </library_visual_scenes>
 <scene><instance_visual_scene url="#scene"/></scene>
</COLLADA>
